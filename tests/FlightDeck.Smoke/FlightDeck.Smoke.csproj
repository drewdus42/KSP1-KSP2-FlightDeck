<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>FlightDeck.Smoke</RootNamespace>
    <AssemblyName>FlightDeck.Smoke</AssemblyName>
    <Description>Loads the built mod next to the real KSP assemblies and exercises the HTTP API on .NET Framework.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlightDeck.Core\FlightDeck.Core.csproj" />
    <ProjectReference Include="..\..\src\KSPFlightDeck\KSPFlightDeck.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(KspManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
